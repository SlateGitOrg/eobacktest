				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"policy_key", Int64.Type}, {"policy_code", type text}, {"policy_name", type text}, {"description", type text}}, "en-US")

	partition fct_backtest = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "\fct_backtest.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"policy_key", Int64.Type}, {"date_key", Int64.Type}, {"reserve_usd", type number}, {"realized_usd", type number}, {"under_reserve_usd", type number}, {"true_pos", Int64.Type}, {"false_pos", Int64.Type}, {"false_neg", Int64.Type}, {"true_neg", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

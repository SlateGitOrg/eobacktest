table fct_backtest
	lineageTag: 44cb4282-b78f-5d60-a003-20c49ccd9207

	measure 'Coverage Ratio' = DIVIDE(SUM(fct_backtest[reserve_usd]), SUM(fct_backtest[realized_usd]))
		formatString: 0.000
		lineageTag: 33f593cd-0e78-50ad-8482-29a4bb06a346

	measure 'Under-reserve $' = SUM(fct_backtest[under_reserve_usd])
		formatString: \$#,0
		lineageTag: d5500912-ecc8-5753-ad1c-e501ccb09b75

	measure 'Flag Precision' = DIVIDE(SUM(fct_backtest[true_pos]), SUM(fct_backtest[true_pos]) + SUM(fct_backtest[false_pos]))
		formatString: 0.0%
		lineageTag: a51a5e40-869d-59f0-b86e-fe240cb46ca8

	measure 'Flag Recall' = DIVIDE(SUM(fct_backtest[true_pos]), SUM(fct_backtest[true_pos]) + SUM(fct_backtest[false_neg]))
		formatString: 0.0%
		lineageTag: 4332f5ef-a55e-5cc4-a814-57d4eb160853

